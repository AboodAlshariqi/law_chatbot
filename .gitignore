# --- secrets -------------------------------------------------------------------------
# The app reads keys from here, falling back to environment variables. Never commit it:
# git keeps history forever, so a key pushed once stays recoverable after it is deleted.
**/.streamlit/secrets.toml
.env

# --- data ----------------------------------------------------------------------------
# ~5 GB, far past what GitHub accepts. data/README.md explains how to obtain and verify it.
data/*
!data/README.md

# --- session logs --------------------------------------------------------------------
# Every question and answer verbatim -- useful for evaluation, not for publishing.
**/logs/
*.jsonl

# --- python ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/

# --- chainlit runtime ------------------------------------------------------------------
.files/
.chainlit/.langchain.db

# --- os ---------------------------------------------------------------------------------
.DS_Store
Thumbs.db
